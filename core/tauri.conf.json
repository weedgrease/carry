{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carry",
  "version": "0.1.0",
  "identifier": "com.weedgrease.carry",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Carry",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/weedgrease/carry/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_BASE64_PUBLIC_KEY"
    }
  }
}
