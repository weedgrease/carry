{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "carry",
  "version": "1.1.0",
  "identifier": "com.weedgrease.carry",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "carry",
        "width": 500,
        "height": 750,
        "minWidth": 480,
        "minHeight": 600,
        "decorations": false,
        "theme": null,
        "backgroundColor": "#252525",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/weedgrease/carry/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFRkYzRDMzOEQ4NjEyNDAKUldSQUVvYU5NejMvUHJ2ajNUbEtZMi83UkNxZlU2ZHI1cnNpQ1FwNHhUT243VTVld1Y5Q3NzZE8K"
    }
  }
}
